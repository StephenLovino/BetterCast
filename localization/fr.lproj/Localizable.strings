/*
  Localizable.strings — français (French)

  Ceci est la traduction française de BetterCast. Les clés sont les chaînes
  sources en anglais et doivent rester identiques au fichier de référence
  localization/en.lproj/Localizable.strings ; seules les valeurs sont traduites.

  Conservez les espaces réservés de format (%@, %lld, %.1f) intacts et dans
  le même ordre que dans le fichier source anglais.
*/

/* Onboarding & guided tour */
"Welcome to BetterCast" = "Bienvenue dans BetterCast";
"A few permissions are needed to get started" = "Quelques autorisations sont nécessaires pour commencer";
"Let's take a quick tour of the app. BetterCast turns any device into a wireless extended display for your Mac." = "Faisons un tour rapide de l'app. BetterCast transforme n'importe quel appareil en écran étendu sans fil pour votre Mac.";
"Overview" = "Vue d'ensemble";
"This is your dashboard. See all connected displays with live previews, manage connections, and use \"Arrange...\" to position displays in System Settings." = "Voici votre tableau de bord. Affichez tous les écrans connectés avec des aperçus en direct, gérez les connexions et utilisez « Disposer… » pour positionner les écrans dans Réglages Système.";
"Device Settings" = "Réglages de l'appareil";
"Click any connected device in the sidebar to adjust resolution, bitrate, Retina mode, and audio streaming for that specific display." = "Cliquez sur un appareil connecté dans la barre latérale pour régler la résolution, le débit, le mode Retina et la diffusion audio de cet écran.";
"Receive Screen" = "Recevoir un écran";
"BetterCast can also receive streams from other Macs. Start listening here and incoming video opens in a separate window." = "BetterCast peut aussi recevoir des flux d'autres Mac. Lancez l'écoute ici et la vidéo entrante s'ouvre dans une fenêtre séparée.";
"Settings" = "Réglages";
"Configure global preferences like connection mode, auto-connect, and manage connected displays." = "Configurez les préférences globales comme le mode de connexion et la connexion automatique, et gérez les écrans connectés.";
"Logs" = "Journaux";
"View detailed connection and streaming logs for troubleshooting. Useful if something isn't working right." = "Consultez les journaux détaillés de connexion et de diffusion pour le dépannage. Utile si quelque chose ne fonctionne pas correctement.";
"You're All Set!" = "Tout est prêt !";
"Connect a receiver device from the sidebar or use \"Receive Screen\" to receive from another Mac. Enjoy your extended display!" = "Connectez un appareil récepteur depuis la barre latérale ou utilisez « Recevoir un écran » pour recevoir depuis un autre Mac. Profitez de votre écran étendu !";
