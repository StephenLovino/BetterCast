/* Info tips */
"Extended creates a separate virtual monitor. Mirror duplicates your main display." = "Erweitert erstellt einen separaten virtuellen Monitor. Spiegeln dupliziert dein Hauptdisplay.";
"Resolution of the virtual display. Higher resolutions use more bandwidth." = "Auflösung des virtuellen Displays. Höhere Auflösungen benötigen mehr Bandbreite.";
"Doubles pixel density. Sharper text but uses more bandwidth." = "Verdoppelt die Pixeldichte. Schärferer Text, benötigt aber mehr Bandbreite.";
"Adjusts the brightness of your built-in display." = "Passt die Helligkeit deines integrierten Displays an.";
"Streams system audio to the receiver. Requires a compatible receiver." = "Streamt Systemaudio an den Empfänger. Erfordert einen kompatiblen Empfänger.";
"Uses legacy display capture to bypass DRM/HDCP blocking (Netflix, Apple TV). May use more CPU and disables audio streaming. Only works when mirroring a physical display." = "Verwendet ältere Displayerfassung, um DRM-/HDCP-Blockierung zu umgehen (Netflix, Apple TV). Kann mehr CPU beanspruchen und deaktiviert Audio-Streaming. Funktioniert nur beim Spiegeln eines physischen Displays.";
"Automatically connect to discovered receivers when they appear on the network." = "Verbindet automatisch mit gefundenen Empfängern, sobald sie im Netzwerk erscheinen.";
"Auto: AWDL for Apple devices, WiFi for others. P2P: forces direct link. Router: uses your WiFi network. Cable: USB/Thunderbolt only." = "Automatisch: AWDL für Apple-Geräte, WLAN für andere. P2P: erzwingt eine Direktverbindung. Router: nutzt dein WLAN. Kabel: nur USB/Thunderbolt.";
"TCP is reliable and works everywhere. UDP has lower latency but only works over P2P/AWDL." = "TCP ist zuverlässig und funktioniert überall. UDP hat geringere Latenz, funktioniert aber nur über P2P/AWDL.";
"Higher quality uses more bandwidth. Use Low/Medium on WiFi, High/Ultra on P2P or cable." = "Höhere Qualität benötigt mehr Bandbreite. Nutze Niedrig/Mittel im WLAN, Hoch/Ultra über P2P oder Kabel.";
"Auto picks the best rate per connection (60). 30 saves bandwidth and battery. 120 is experimental for high-refresh receivers; needs a strong link and doubles bandwidth. Hit Apply Settings (or reconnect) to take effect." = "Automatisch wählt die beste Rate pro Verbindung (60). 30 spart Bandbreite und Akku. 120 ist experimentell für Empfänger mit hoher Bildwiederholrate; benötigt eine starke Verbindung und verdoppelt die Bandbreite. Klicke auf Einstellungen anwenden (oder verbinde neu), damit die Änderung wirksam wird.";
"Streams system audio to this receiver." = "Streamt Systemaudio an diesen Empfänger.";
"Switches to a wireless ADB tunnel so you can unplug the cable. Stays connected through the handoff." = "Wechselt zu einem drahtlosen ADB-Tunnel, damit du das Kabel abziehen kannst. Die Verbindung bleibt während der Übergabe bestehen.";
"Plug in a USB cable first. USB gives lower latency and higher bandwidth than WiFi." = "Schließe zuerst ein USB-Kabel an. USB bietet geringere Latenz und höhere Bandbreite als WLAN.";
"Streams via USB using Android Debug Bridge. Highest quality with no network needed. Plug in your Android device first." = "Streamt über USB mit Android Debug Bridge. Höchste Qualität ganz ohne Netzwerk. Schließe zuerst dein Android-Gerät an.";
"Wireless ADB tunnel. Connect USB once to pair, then unplug and stream wirelessly at full quality." = "Drahtloser ADB-Tunnel. Verbinde einmal per USB zum Koppeln, dann Kabel abziehen und drahtlos in voller Qualität streamen.";
"Connects directly over WiFi without ADB. Lower FPS but no USB setup required." = "Verbindet direkt über WLAN ohne ADB. Niedrigere FPS, aber keine USB-Einrichtung erforderlich.";
"Connects over your local network. Apple devices use AWDL peer-to-peer when available for best performance." = "Verbindet über dein lokales Netzwerk. Apple-Geräte nutzen wenn verfügbar AWDL-Peer-to-Peer für die beste Leistung.";

/* Donation prompt */
"Want me to keep building free stuff?" = "Soll ich weiter kostenlose Software bauen?";
"BetterCast is free, has no ads, and does not track you. If it saved you the price of a second monitor, a coffee goes a long way." = "BetterCast ist kostenlos, werbefrei und trackt dich nicht. Wenn es dir einen zweiten Monitor erspart hat, hilft ein Kaffee schon sehr.";
"Buy me a coffee" = "Spendier mir einen Kaffee";
"Maybe later" = "Vielleicht später";
"I already donated — stop asking" = "Ich habe bereits gespendet — nicht mehr fragen";

/* Smooth motion (per-receiver burst ceiling) */
"Smooth Motion" = "Bewegung glätten";
"Lets the encoder spend more bits the moment the picture moves, instead of holding a steady ceiling. Fixes the softness on scene changes and fast motion over Wi-Fi, at the cost of burstier traffic. Takes effect immediately." = "Lässt den Encoder mehr Bits einsetzen, sobald sich das Bild bewegt, statt eine feste Obergrenze zu halten. Behebt die Unschärfe bei Szenenwechseln und schnellen Bewegungen über WLAN, um den Preis ungleichmäßigeren Datenverkehrs. Wirkt sofort.";

