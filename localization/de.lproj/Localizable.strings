/*
  Localizable.strings — German (Deutsch)

  This is the German translation of BetterCast. Keys are the English source
  strings from localization/en.lproj/Localizable.strings and must contain the
  same set of keys as the canonical English file.

  To contribute a new language, copy the English file to localization/<code>.lproj/
  (e.g. es.lproj), translate the right-hand values, and open a pull request.
  Keep format placeholders (%@, %lld, %.1f) intact and in the same order.
*/

/* Onboarding & guided tour */
"Welcome to BetterCast" = "Willkommen bei BetterCast";
"A few permissions are needed to get started" = "Zum Loslegen werden einige Berechtigungen benötigt";
"Let's take a quick tour of the app. BetterCast turns any device into a wireless extended display for your Mac." = "Machen wir eine kurze Tour durch die App. BetterCast verwandelt jedes Gerät in ein kabelloses erweitertes Display für deinen Mac.";
"Overview" = "Übersicht";
"This is your dashboard. See all connected displays with live previews, manage connections, and use \"Arrange...\" to position displays in System Settings." = "Dies ist dein Dashboard. Sieh alle verbundenen Displays mit Live-Vorschau, verwalte Verbindungen und nutze \"Anordnen...\", um Displays in den Systemeinstellungen zu positionieren.";
"Device Settings" = "Geräteeinstellungen";
"Click any connected device in the sidebar to adjust resolution, bitrate, Retina mode, and audio streaming for that specific display." = "Klicke auf ein verbundenes Gerät in der Seitenleiste, um Auflösung, Bitrate, Retina-Modus und Audio-Streaming für dieses Display anzupassen.";
"Receive Screen" = "Bildschirm empfangen";
"BetterCast can also receive streams from other Macs. Start listening here and incoming video opens in a separate window." = "BetterCast kann auch Streams von anderen Macs empfangen. Starte hier den Empfang, und eingehendes Video wird in einem separaten Fenster geöffnet.";
"Settings" = "Einstellungen";
"Configure global preferences like connection mode, auto-connect, and manage connected displays." = "Konfiguriere globale Einstellungen wie Verbindungsmodus und Auto-Verbinden und verwalte verbundene Displays.";
"Logs" = "Protokolle";
"View detailed connection and streaming logs for troubleshooting. Useful if something isn't working right." = "Zeige detaillierte Verbindungs- und Streaming-Protokolle zur Fehlersuche an. Nützlich, wenn etwas nicht richtig funktioniert.";
"You're All Set!" = "Alles bereit!";
"Connect a receiver device from the sidebar or use \"Receive Screen\" to receive from another Mac. Enjoy your extended display!" = "Verbinde ein Empfangsgerät über die Seitenleiste oder nutze \"Bildschirm empfangen\", um von einem anderen Mac zu empfangen. Viel Spaß mit deinem erweiterten Display!";
